/**
 * Loading from Back-Forward Cache causes many problems on the website.
 * It's mostly related to the old pages loaded with mobile devices (but not limited to these)
 * More: https://developer.mozilla.org/en-US/docs/Mozilla/Firefox/Releases/1.5/Using_Firefox_1.5_caching
 */
(function handleBfcache() {
  window.onpageshow = function reloadOnPersisted(evt) {
    if (evt.persisted) {
      window.location.reload();
    }
  };
})();
